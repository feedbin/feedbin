<% content_for :form_content do %>
<div class="border rounded-md p-6 md:p-12 mb-8">
  <h1 class="font-bold text-lg mb-4">Allow <%= @pre_auth.client.name %> to use your Feedbin account?</h1>

  <%= form_tag oauth_authorization_path, method: :post, novalidate: true do %>
    <%= render "doorkeeper/authorizations/hidden_fields" %>
    <%= render partial: "shared/flash", locals: {flash: flash} %>
    <% if signed_in? %>
      <button type="submit" class="button flex w-full">Authorize</button>
    <% else %>
      <%= email_field_tag :email, flash[:email], class: "text-input" %>
      <%= password_field_tag :password, nil, class: "text-input" %>
      <button type="submit" class="button flex w-full">Sign in and authorize</button>
    <% end %>
  <% end %>
  <%= form_tag oauth_authorization_path, method: :delete do %>
    <%= render "doorkeeper/authorizations/hidden_fields" %>
    <button type="submit" class="button button-secondary flex w-full">Cancel</button>
  <% end %>
</div>
<% end %>

<%= render template: "layouts/form_page" %>
