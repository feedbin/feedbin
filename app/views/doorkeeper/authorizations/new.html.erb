<% app_name = @pre_auth.client.name %>
<% logo_url = Api::V3::ApplicationProfile.for(@pre_auth.client.application).logo_url %>

<% content_for :form_content do %>
<div class="border rounded-md w-full max-w-[480px] mx-auto p-[40px]">
  <% if logo_url %>
    <%= image_tag logo_url, alt: app_name, class: "block w-16 h-16 rounded-[14px] object-contain mx-auto mb-4" %>
  <% end %>
  <h1 class="font-bold text-lg text-center mb-6"><%= app_name %> is requesting access to your account</h1>

  <%= render partial: "shared/flash", locals: {flash: flash} %>

  <%= form_tag oauth_authorization_path, method: :post, novalidate: true, data: {controller: "oauth-form", action: "visual-viewport:change@window->oauth-form#reveal"} do %>
    <%= render "doorkeeper/authorizations/hidden_fields" %>
    <% if signed_in? %>
      <p class="text-center mb-6">
        Signed in as <strong class="text-700 break-all"><%= current_user.email %></strong>.
        <button type="submit" form="oauth_switch_account" class="text-blue-600 whitespace-nowrap">Not you?</button>
      </p>
    <% else %>
      <div class="mb-4">
        <%= render Form::TextInputComponent.new do |text| %>
          <% text.label_content do %>
            <label for="email">Email</label>
          <% end %>
          <% text.input do %>
            <%= email_field_tag :email, flash[:email], class: "peer text-input !text-[16px] dark:[color-scheme:dark]", autocomplete: "username", autocapitalize: "off", autocorrect: "off", spellcheck: "false", enterkeyhint: "next", data: {action: "keydown.enter->oauth-form#next"} %>
          <% end %>
        <% end %>
      </div>
      <div class="mb-6">
        <%= render Form::TextInputComponent.new do |text| %>
          <% text.label_content do %>
            <div class="flex items-center">
              <label for="password">Password</label>
              <%= link_to "Forgot your password?", new_password_reset_path, class: "ml-auto text-sm" %>
            </div>
          <% end %>
          <% text.input do %>
            <%= password_field_tag :password, nil, class: "text-input !text-[16px] dark:[color-scheme:dark]", autocomplete: "current-password", enterkeyhint: "go", data: {oauth_form_target: "password"} %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <button type="submit" class="button flex w-full min-h-[44px]" data-oauth-form-target="submit">Authorize</button>
  <% end %>

  <% if signed_in? %>
    <%= form_tag oauth_session_path, method: :delete, id: "oauth_switch_account" do %>
      <%= render "doorkeeper/authorizations/hidden_fields" %>
    <% end %>
  <% end %>
</div>
<% if !signed_in? && Api::V3::Scopes.first_party?(@pre_auth.client.application) %>
  <%# The same request, taken to the sign-up page; its scope is worked out there again. %>
  <% registration_params = {
    client_id: @pre_auth.client.uid, redirect_uri: @pre_auth.redirect_uri, state: @pre_auth.state,
    response_type: @pre_auth.response_type, response_mode: @pre_auth.response_mode,
    code_challenge: @pre_auth.code_challenge, code_challenge_method: @pre_auth.code_challenge_method
  }.compact_blank %>
  <p class="text-center text-500 mt-6">New to Feedbin?</p>
  <p class="text-center"><%= link_to "Create an account", new_oauth_registration_path(registration_params), class: "font-medium" %></p>
<% end %>

<% end %>

<%= render template: "layouts/oauth_page" %>
