<%= render Settings::H1Component.new do %>
  <span class="line-through"><%= @deleted_user.email %></span>
<% end %>
<%= render Settings::SubtitleComponent.new do %>
  Closed account<%= " #{@deleted_user.original_user_id}" if @deleted_user.original_user_id %><%= ", closed #{@deleted_user.created_at.to_formatted_s(:date)}" if @deleted_user.created_at %>. <%= link_to "All customers", admin_users_path %>
<% end %>

<%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
  <% group.header do %>
    Billing
  <% end %>
  <% if @deleted_user.customer_id.present? %>
    <% group.item do %>
      <%= render partial: "admin/users/fact", locals: {title: "Stripe customer", description: @deleted_user.customer_id, value: link_to("Open in Stripe", @deleted_user.stripe_url)} %>
    <% end %>
  <% end %>
  <% @deleted_user.store_subscriptions.each do |reference| %>
    <% group.item do %>
      <%= render partial: "admin/users/fact", locals: {
        title: "#{biller_name(reference["store"])} subscription",
        description: safe_join([reference["product_id"], "Store's ID #{reference["external_id"]}"].compact, tag.br),
        value: "Only its owner can cancel it"
      } %>
    <% end %>
  <% end %>
  <% group.item do %>
    <%= render partial: "admin/users/fact", locals: {
      title: "Told it is still being charged",
      value: @deleted_user.store_billing_notified_at ? @deleted_user.store_billing_notified_at.to_formatted_s(:date) : "Not emailed"
    } %>
  <% end %>
<% end %>

<%= render partial: "admin/users/notifications", locals: {notifications: @deleted_user.app_store_notifications} %>
