<%= render Settings::H1Component.new do %>
  <span class="line-through"><%= @deleted_user.email %></span>
<% end %>
<%= render Settings::SubtitleComponent.new do %>
  Closed account<%= " #{@deleted_user.original_user_id}" if @deleted_user.original_user_id %>. <%= link_to "All customers", admin_users_path %>
<% end %>

<%= render layout: "admin/users/summary", locals: {summary: closed_summary(@deleted_user)} do %>
  <%= link_to "Open in Stripe", @deleted_user.stripe_url, class: "button" if @deleted_user.customer_id.present? %>
<% end %>

<% if @deleted_user.store_subscriptions.any? %>
  <%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
    <% group.header do %>
      Details
    <% end %>
    <% @deleted_user.store_subscriptions.each do |reference| %>
      <% group.item do %>
        <%= render partial: "admin/users/fact", locals: {title: "#{biller_name(reference["store"])}'s ID for the subscription", description: reference["product_id"], value: reference["external_id"]} %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render partial: "admin/users/notifications", locals: {notifications: @deleted_user.app_store_notifications} %>
