<% subscription = @customer.billing_subscription %>
<% source = @customer.billing_source(subscription) %>
<% others = @customer.store_subscriptions.where.not(id: subscription&.id).order(expires_at: :desc) %>
<% purchases = @customer.purchases %>
<% stripe_events = @customer.billing_events.order(created_at: :desc) %>

<%= render Settings::H1Component.new do %>
  <%= @customer.email %>
<% end %>
<%= render Settings::SubtitleComponent.new do %>
  Account <%= @customer.id %>, created <%= @customer.created_at.to_formatted_s(:date) %>. <%= link_to "All customers", admin_users_path %>
<% end %>

<%= render layout: "summary", locals: {summary: billing_summary(@customer, subscription)} do %>
  <%= link_to "Open in Stripe", @customer.stripe_url, class: "button" if source == "web" && @customer.customer_id.present? %>
<% end %>

<%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
  <% group.header do %>
    Details
  <% end %>
  <% group.item do %>
    <%= render partial: "fact", locals: {title: "Plan in the database", value: @customer.plan.stripe_id} %>
  <% end %>
  <% if subscription && source != "web" %>
    <% group.item do %>
      <%= render partial: "fact", locals: {
        title: "#{biller_name(subscription.store)}'s ID for the subscription",
        description: [subscription.product_id, (subscription.environment unless subscription.environment == "production")].compact.join(" · "),
        value: subscription.external_id
      } %>
    <% end %>
    <% if subscription.verified_at %>
      <% group.item do %>
        <%= render partial: "fact", locals: {title: "Last checked with #{biller_name(subscription.store)}", value: subscription.verified_at.to_formatted_s(:date)} %>
      <% end %>
    <% end %>
    <% if subscription.renews_as %>
      <% group.item do %>
        <%= render partial: "fact", locals: {title: "Changes plan at renewal", value: subscription.renews_as} %>
      <% end %>
    <% end %>
    <% if subscription.moved_at %>
      <% group.item do %>
        <%= render partial: "fact", locals: {title: "Moved here from another account", value: subscription.moved_at.to_formatted_s(:date)} %>
      <% end %>
    <% end %>
  <% end %>
  <% if @customer.customer_id.present? && source != "web" %>
    <% group.item do %>
      <%= render partial: "fact", locals: {title: "Stripe customer", description: @customer.customer_id, value: link_to("Open in Stripe", @customer.stripe_url)} %>
    <% end %>
  <% end %>
  <% group.item do %>
    <%= render partial: "fact", locals: {title: "Price tier", value: @customer.price_tier} %>
  <% end %>
<% end %>

<% if others.any? %>
  <%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
    <% group.header do %>
      Earlier Store Subscriptions
    <% end %>
    <% others.each do |other| %>
      <% group.item do %>
        <%= render partial: "fact", locals: {
          title: [biller_name(other.store), other.period&.capitalize].compact.join(" · "),
          description: other.external_id,
          value: store_subscription_standing(other)
        } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if purchases.any? %>
  <%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
    <% group.header do %>
      Recent Payments
    <% end %>
    <% purchases.first(6).each do |purchase| %>
      <% group.item do %>
        <%= render partial: "fact", locals: {title: purchase.receipt_date, description: payment_source(purchase), value: payment_amount(purchase)} %>
      <% end %>
    <% end %>
    <% if purchases.size > 6 %>
      <% group.description do %>
        The last 6 of <%= number_with_delimiter(purchases.size) %>.
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render partial: "notifications", locals: {notifications: @customer.app_store_notifications} %>

<% if stripe_events.any? %>
  <%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
    <% group.header do %>
      Recent Stripe Events
    <% end %>
    <% stripe_events.limit(8).each do |event| %>
      <% group.item do %>
        <%= render partial: "fact", locals: {title: event.event_type, value: event.created_at.to_formatted_s(:date)} %>
      <% end %>
    <% end %>
    <% if stripe_events.count > 8 %>
      <% group.description do %>
        The last 8 of <%= number_with_delimiter(stripe_events.count) %>.
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
  <% group.header do %>
    Account
  <% end %>
  <% group.item do %>
    <%= render Settings::ControlRowComponent.new do |row| %>
      <% row.title do %>Password<% end %>
      <% row.control do %>
        <%= link_to "Reset Password", reset_password_admin_user_path(@customer), remote: true, data: {confirm: "Are you sure?"}, method: :post %>
      <% end %>
    <% end %>
  <% end %>
  <% group.item do %>
    <%= render Settings::ControlRowComponent.new do |row| %>
      <% row.title do %>Close the account<% end %>
      <% if subscription&.entitling? %>
        <% row.description do %>A store bills this account, and only its owner can cancel that. Closing it does not stop the charges.<% end %>
      <% end %>
      <% row.control do %>
        <%= link_to "Delete", admin_user_path(@customer), remote: true, data: {confirm: "Are you sure?"}, method: :delete, class: "!text-red-600" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
