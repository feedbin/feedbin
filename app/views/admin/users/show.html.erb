<% subscription = @customer.billing_subscription %>
<% source = @customer.billing_source(subscription) %>
<% subscriptions = @customer.store_subscriptions.order(Arel.sql("status IN (0, 1) DESC"), expires_at: :desc) %>
<% purchases = @customer.purchases %>
<% stripe_events = @customer.billing_events.order(created_at: :desc) %>

<%= render Settings::H1Component.new do %>
  <%= @customer.email %>
<% end %>
<%= render Settings::SubtitleComponent.new do %>
  Account <%= @customer.id %>, created <%= @customer.created_at.to_formatted_s(:date) %>. <%= link_to "All customers", admin_users_path %>
<% end %>

<%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
  <% group.header do %>
    Billing
  <% end %>
  <% group.item do %>
    <%= render partial: "fact", locals: {title: "Standing", value: account_standing(@customer)} %>
  <% end %>
  <% group.item do %>
    <%= render partial: "fact", locals: {title: "Plan", description: @customer.plan.stripe_id, value: @customer.plan.name} %>
  <% end %>
  <% group.item do %>
    <%= render partial: "fact", locals: {title: "Billed by", value: biller_name(source)} %>
  <% end %>
  <% if subscription && source != "web" %>
    <% group.item do %>
      <%= render partial: "fact", locals: {title: "Subscription", description: subscription.product_id, value: store_subscription_standing(subscription)} %>
    <% end %>
  <% end %>
  <% if @customer.expires_at && (@customer.trial_plan? || @customer.timed_plan?) %>
    <% group.item do %>
      <%= render partial: "fact", locals: {title: @customer.trial_plan? ? "Trial ends" : "Paid until", value: @customer.expires_at.to_formatted_s(:date)} %>
    <% end %>
  <% end %>
  <% if @customer.billing_issue? %>
    <% group.item do %>
      <%= render partial: "fact", locals: {title: "Payment problem", value: "The last payment failed"} %>
    <% end %>
  <% end %>
  <% group.item do %>
    <%= render partial: "fact", locals: {title: "Price tier", value: @customer.price_tier} %>
  <% end %>
  <% if @customer.customer_id.present? %>
    <% group.item do %>
      <%= render partial: "fact", locals: {title: "Stripe customer", description: @customer.customer_id, value: link_to("Open in Stripe", @customer.stripe_url)} %>
    <% end %>
  <% end %>
<% end %>

<% if subscriptions.any? %>
  <%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
    <% group.header do %>
      Store Subscriptions
    <% end %>
    <% subscriptions.each do |store_subscription| %>
      <% group.item do %>
        <%= render partial: "fact", locals: {
          title: "#{biller_name(store_subscription.store)} · #{store_subscription.period&.capitalize || store_subscription.product_id}",
          description: safe_join([
            [store_subscription.product_id, store_subscription_price(store_subscription), (store_subscription.environment unless store_subscription.environment == "production")].compact.join(" · "),
            "Store's ID #{store_subscription.external_id}",
            ("Becomes #{store_subscription.renews_as} at renewal" if store_subscription.renews_as),
            ("Moved here #{store_subscription.moved_at.to_formatted_s(:date)}" if store_subscription.moved_at),
            ("Last checked with the store #{store_subscription.verified_at.to_formatted_s(:date)}" if store_subscription.verified_at)
          ].compact, tag.br),
          value: store_subscription_standing(store_subscription)
        } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if purchases.any? %>
  <%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
    <% group.header do %>
      Payments
    <% end %>
    <% purchases.first(12).each do |purchase| %>
      <% group.item do %>
        <%= render partial: "fact", locals: {
          title: purchase.receipt_date,
          description: payment_source(purchase),
          value: payment_amount(purchase)
        } %>
      <% end %>
    <% end %>
    <% if purchases.size > 12 %>
      <% group.description do %>
        Showing the last 12 of <%= number_with_delimiter(purchases.size) %> payments.
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render partial: "notifications", locals: {notifications: @customer.app_store_notifications} %>

<% if stripe_events.any? %>
  <%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
    <% group.header do %>
      What Stripe Has Said
    <% end %>
    <% stripe_events.limit(15).each do |event| %>
      <% group.item do %>
        <%= render partial: "fact", locals: {title: event.event_type, value: event.created_at.to_formatted_s(:date)} %>
      <% end %>
    <% end %>
    <% if stripe_events.count > 15 %>
      <% group.description do %>
        Showing the last 15 of <%= number_with_delimiter(stripe_events.count) %> events.
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
  <% group.header do %>
    Account
  <% end %>
  <% group.item do %>
    <%= render Settings::ControlRowComponent.new do |row| %>
      <% row.title do %>Password<% end %>
      <% row.control do %>
        <%= link_to "Reset Password", reset_password_admin_user_path(@customer), remote: true, data: {confirm: "Are you sure?"}, method: :post %>
      <% end %>
    <% end %>
  <% end %>
  <% group.item do %>
    <%= render Settings::ControlRowComponent.new do |row| %>
      <% row.title do %>Close the account<% end %>
      <% if subscriptions.select(&:entitling?).any? %>
        <% row.description do %>A store bills this account, and only its owner can cancel that. Closing it does not stop the charges.<% end %>
      <% end %>
      <% row.control do %>
        <%= link_to "Delete", admin_user_path(@customer), remote: true, data: {confirm: "Are you sure?"}, method: :delete, class: "!text-red-600" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
