<div class="entry-button-wrap settings-button-wrap">
    <%= link_to settings_path, class: "app-settings-button" do %>
        <div class="entry-button">
            <div class="hamburger-menu-wrap" title="Settings" role="button">
                <div class="hamburger-menu"></div>
            </div>
        </div>
    <% end %>

    <a href="<%= settings_path %>" class="entry-button web-settings-button" data-behavior="toggle_settings_menu" title="Settings" data-toggle="tooltip">
        <%= svg_tag "icon-menu" %>
    </a>
</div>
