<% subscription = @user.billing_subscription %>
<%= render Settings::ControlGroupComponent.new class: "mb-14" do |group| %>
  <% group.header do %>
    Your Plan
  <% end %>
  <% group.item do %>
    <%= render Settings::ControlRowComponent.new do |row| %>
      <% row.title do %>
        <%= (subscription&.period == "yearly") ? "Feedbin Yearly" : "Feedbin Monthly" %>
      <% end %>
      <% if subscription %>
        <% row.description { store_subscription_summary(subscription) } %>
      <% end %>
    <% end %>
  <% end %>
  <% group.description do %>
    <% if subscription %>
      Billed by <%= store_name(subscription) %>. Cancel or change your plan in <%= store_name(subscription) %>’s subscription settings, or in the Feedbin app under Settings → Billing.
    <% else %>
      You can manage your subscription in the Feedbin app.
    <% end %>
  <% end %>
<% end %>

<%= render partial: "shared/billing/payment_history", locals: {limit: 12} %>

<%= render partial: "shared/billing/receipt_info" %>
