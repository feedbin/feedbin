$("[data-content-src='<%= j account_migrations_path %>']").html('<%= j render partial: "account_migration" %>');
<%# Nothing left to poll for: no migration to watch, or one that has finished. %>
<% if @migration.nil? || @migration.complete? || @migration.failed? %>
clearInterval(feedbin.remoteContentIntervals["<%= j request.path_info %>"]);
<% end %>